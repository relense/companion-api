{
  "openapi": "3.0.0",
  "info": {
    "title": "Companion API",
    "version": "0.0.1"
  },
  "tags": [
    {
      "name": "client",
      "description": "Operations related to client management"
    }
  ],
  "servers": [
    {
      "url": "http://localhost:4000/messages"
    }
  ],
  "paths": {
    "/messages": {
      "post": {
        "summary": "Create a Message",
        "operationId": "createMessage",
        "tags": ["messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "The message content"
                  }
                },
                "required": ["message"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successfully created a message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messageId": {
                      "type": "string",
                      "description": "The ID of the created message"
                    },
                    "description": {
                      "type": "string",
                      "description": "Content of the message"
                    }
                  },
                  "required": ["messageId", "description"]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        },
        "x-order": 0
      }
    }
  },
  "components": {
    "responses": {
      "BadRequest": {
        "description": "Invalid request data",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": ["message"]
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": ["message"]
            }
          }
        }
      }
    }
  }
}
