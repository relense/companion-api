{
  "openapi": "3.0.0",
  "security": [{ "ApiKey": [] }],
  "info": {
    "title": "Companion API",
    "version": "0.0.1"
  },
  "tags": [],
  "paths": {
    "/messages": {
      "post": {
        "summary": "Create a Message",
        "operationId": "createMessage",
        "tags": ["messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "The message content"
                  }
                },
                "required": ["message"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successfully created a message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messageId": {
                      "type": "string",
                      "description": "The ID of the created message"
                    },
                    "description": {
                      "type": "string",
                      "description": "Content of the message"
                    }
                  },
                  "required": ["messageId", "description"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          }
        },
        "x-order": 0
      },
      "get": {
        "summary": "Get a list of all messages",
        "operationId": "getMessages",
        "parameters": [
          {
            "description": "Maximum number of results returned (25 by default)",
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 1000,
              "default": 25
            }
          },
          {
            "description": "Page of results to be fetched from the server (1 by default)",
            "name": "page",
            "in": "query",
            "schema": { "type": "number", "minimum": 1, "default": 1 }
          }
        ],
        "tags": ["messages"],
        "responses": {
          "200": {
            "description": "Successfully fetched a list of all Messages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "messageId": { "type": "string" },
                          "description": { "type": "string" },
                          "createdAt": { "type": "string" }
                        },
                        "required": ["messageId", "description", "createdAt"]
                      }
                    },
                    "meta": {
                      "type": "object",
                      "description": "Information about the results",
                      "properties": {
                        "pageSize": {
                          "type": "number",
                          "description": "Maximum number of results return in a single request"
                        },
                        "previousPage": {
                          "type": "number",
                          "description": "Number of the previous page. If empty, means the current page is the first one"
                        },
                        "nextPage": {
                          "type": "number",
                          "description": "Number of the next page. If empty, means the current page is the last one"
                        },
                        "pageCount": {
                          "type": "number",
                          "description": "Total number of pages found"
                        },
                        "itemCount": {
                          "type": "number",
                          "description": "Total number of items found"
                        }
                      },
                      "required": ["pageSize", "pageCount", "itemCount"]
                    },
                    "links": {
                      "type": "object",
                      "properties": {
                        "self": { "type": "string" },
                        "next": { "type": "string" },
                        "prev": { "type": "string" }
                      },
                      "required": ["self"]
                    }
                  },
                  "required": ["items", "meta", "links"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          }
        }
      }
    },
    "/messages/{messageId}": {
      "get": {
        "summary": "Get a specific message",
        "operationId": "getMessage",
        "parameters": [
          {
            "name": "messageId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "minLength": 1, "maxLength": 40 }
          }
        ],
        "tags": ["messages"],
        "responses": {
          "200": {
            "description": "Successfully fetched details about a message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messageId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40
                    },
                    "description": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2021-01-01T08:00:00Z"
                    }
                  },
                  "required": ["messageId", "description", "createdAt"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "message": { "type": "string" } }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "message": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:4000/client"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKey": { "type": "apiKey", "name": "apiKey", "in": "header" }
    },
    "schemas": {}
  }
}
