              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          }
        },
        "x-order": 0
      },
      "get": {
        "summary": "Get a list of all accounts",
        "operationId": "getAccounts",
        "parameters": [
          {
            "description": "Maximum number of results returned (25 by default)",
            "name": "PageSize",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 1000,
              "default": 25
            }
          },
          {
            "description": "Page of results to be fetched from the server (1 by default)",
            "name": "Page",
            "in": "query",
            "schema": { "type": "number", "minimum": 1, "default": 1 }
          }
        ],
        "tags": ["accounts"],
        "responses": {
          "200": {
            "description": "Successfully fetched a list of all accounts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "SubscriptionId": { "type": "string" }
                        },
                        "required": ["SubscriptionId"]
                      }
                    },
                    "Meta": {
                      "type": "object",
                      "description": "Information about the results",
                      "properties": {
                        "PageSize": {
                          "type": "number",
                          "description": "Maximum number of results return in a single request"
                        },
                        "PreviousPage": {
                          "type": "number",
                          "description": "Number of the previous page. If empty, means the current page is the first one"
                        },
                        "NextPage": {
                          "type": "number",
                          "description": "Number of the next page. If empty, means the current page is the last one"
                        },
                        "PageCount": {
                          "type": "number",
                          "description": "Total number of pages found"
                        },
                        "ItemCount": {
                          "type": "number",
                          "description": "Total number of items found"
                        }
                      },
                      "required": ["PageSize", "PageCount", "ItemCount"]
                    }
                  },
                  "required": ["Items", "Meta"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
