  "paths": {
    "/messages": {
      "post": {
        "summary": "Create a Message",
        "operationId": "createMessage",
        "tags": ["messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "message": {
                    "type": "string",
                    "description": "The message content"
                  }
                },
                "required": ["message"]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successfully created a message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "messageId": {
                      "type": "string",
                      "description": "The ID of the created message"
                    },
                    "description": {
                      "type": "string",
                      "description": "Content of the message"
                    }
                  },
                  "required": ["messageId", "description"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          }
        },
        "x-order": 0
      },
      "get": {
        "summary": "Get a list of all messages",
        "operationId": "getMessages",
        "parameters": [
          {
            "description": "Maximum number of results returned (25 by default)",
            "name": "PageSize",
            "in": "query",
            "schema": {
              "type": "number",
              "minimum": 1,
              "maximum": 1000,
              "default": 25
            }
          },
          {
            "description": "Page of results to be fetched from the server (1 by default)",
            "name": "Page",
            "in": "query",
            "schema": { "type": "number", "minimum": 1, "default": 1 }
          }
        ],
        "tags": ["messages"],
        "responses": {
          "200": {
            "description": "Successfully fetched a list of all Messages",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "SubscriptionId": { "type": "string" }
                        },
                        "required": ["SubscriptionId"]
                      }
                    },
                    "Meta": {
                      "type": "object",
                      "description": "Information about the results",
                      "properties": {
                        "PageSize": {
                          "type": "number",
                          "description": "Maximum number of results return in a single request"
                        },
                        "PreviousPage": {
                          "type": "number",
                          "description": "Number of the previous page. If empty, means the current page is the first one"
                        },
                        "NextPage": {
                          "type": "number",
                          "description": "Number of the next page. If empty, means the current page is the last one"
                        },
                        "PageCount": {
                          "type": "number",
                          "description": "Total number of pages found"
                        },
                        "ItemCount": {
                          "type": "number",
                          "description": "Total number of items found"
                        }
                      },
                      "required": ["PageSize", "PageCount", "ItemCount"]
                    },
                    "Links": {
                      "type": "object",
                      "properties": {
                        "Self": { "type": "string" },
                        "Next": { "type": "string" },
                        "Prev": { "type": "string" }
                      },
                      "required": ["Self"]
                    }
                  },
                  "required": ["Items", "Meta", "Links"]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": ["message"]
                }
              }
            }
          }
        },
        "x-order": 1
      }
    },
